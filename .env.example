# RoundOne Candidate — frontend (Vite). Copy to `.env.local` for local development.
# Never put service_role or AI provider secrets in VITE_* variables.

VITE_SUPABASE_URL=https://fhcrxjrqtojixgqemofp.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Optional. Public Google OAuth web client ID used by Google One Tap.
# In Google Cloud Console, Authorized JavaScript origins must include:
#   https://www.jobround.ai
#   https://jobround.ai
#   http://localhost:5173
# Authorized redirect URIs must include:
#   https://fhcrxjrqtojixgqemofp.supabase.co/auth/v1/callback
# VITE_GOOGLE_CLIENT_ID=your_google_oauth_web_client_id.apps.googleusercontent.com

# Optional product demo on the public homepage (with audio).
# Generate locally: npm run dev && npx playwright install chromium && npm run record:demo
# Preview film: http://localhost:5173/product-film
# Output: public/demo/product-demo.webm (+ .mp4 if ffmpeg is installed)
# Or set a CDN URL:
# VITE_DEMO_VIDEO_URL=https://cdn.example.com/jobround-demo.mp4
# Or embed from YouTube (ID only):
# VITE_DEMO_VIDEO_YOUTUBE_ID=your_youtube_video_id
